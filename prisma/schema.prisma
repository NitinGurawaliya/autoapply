generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  autoReadOtp   Boolean   @default(false) // user consented to the email-code agent reading their mailbox
  createdAt     DateTime  @default(now())

  profile      Profile?
  answers      Answer[]
  swipes       Swipe[]
  applications Application[]
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  isTest          Boolean @default(false)
  resumeKey       String
  resumeText      String
  fullName        String
  email           String
  phone           String?
  city            String?
  country         String?
  linkedin        String?
  github          String?
  portfolio       String?
  yearsExperience Float?
  currentTitle    String?
  currentCompany  String?
  skills          Json
  experience      Json
  education       Json
  rawJson         Json
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Answer {
  id        String   @id @default(cuid())
  userId    String
  key       String
  question  String
  answer    String
  source    String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model Company {
  id             String    @id @default(cuid())
  source         String
  slug           String
  name           String
  active         Boolean   @default(true)
  lastFetchedAt  DateTime?
  lastFetchCount Int?
  jobs           Job[]

  @@unique([source, slug])
}

model Job {
  id            String   @id @default(cuid())
  source        String
  externalId    String
  companyId     String
  title         String
  location      String
  country       String
  remoteType    String
  experienceMin Int?
  description   String
  applyUrl      String
  postedAt      DateTime
  fetchedAt     DateTime
  raw           Json

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([country])
}

model Swipe {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  direction String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Application {
  id                String    @id @default(cuid())
  userId            String
  jobId             String
  status            String
  attempt           Int       @default(0)
  fields            Json
  pendingQuestions  Json
  screenshotKey     String?
  error             String?
  submittedAt       DateTime?
  verificationCode  String?   // one-time ATS email code typed by the user; cleared as soon as the worker reads it
  codeRequestId     String?   // id of the in-flight email-code agent request; callbacks must match it
  codeRequestStatus String?   // pending | found | not_found | ambiguous | no_access | failed
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ApplicationEvent[]

  @@index([userId, status])
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  type          String
  message       String
  rule          String?
  data          Json?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model FileBlob {
  key         String   @id
  bytes       Bytes
  contentType String
  size        Int
  userId      String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model MockSubmission {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now())
}

model FieldMappingCache {
  id        String   @id @default(cuid())
  source    String
  labelHash String
  key       String
  createdAt DateTime @default(now())

  @@unique([source, labelHash])
}
