generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  autoReadOtp   Boolean   @default(false) // user consented to the email-code agent reading their mailbox
  createdAt     DateTime  @default(now())
  // The newest job a "new matches" push has covered (lib/push.ts, modules/jobs/warm.ts): later ones are new.
  matchesAlertedAt DateTime?
  // Phase V, V1 (modules/accounts): the password the agent made for this user's employer accounts (Workday and the other
  // boards that need one), AES-256-GCM with ACCOUNTS_KEY. Shown to the user in Account; never logged.
  applicationSecret   String?
  applicationSecretAt DateTime?

  profile      Profile?
  answers      Answer[]
  swipes       Swipe[]
  applications Application[]
  accounts     Account[]
  sessions     Session[]
  pushSubscriptions PushSubscription[]
  siteConnections   SiteConnection[]
  brief        CandidateBrief?
  dailySets    DailySet[]
  employerAccounts EmployerAccount[]
  funnelEvents FunnelEvent[]
  // Phase Y, Y2 (docs/whatsapp/TDD.md 4.3): the WhatsApp number linked to this user, if any.
  whatsapp     WhatsAppLink?
}

// Phase P, P5 (modules/profile/brief.ts): what the agent knows about the candidate for judging fit: tracks, nearby,
// years, title, top skills; never contact data. Its own table, so a rebuild leaves Profile.updatedAt alone.
model CandidateBrief {
  userId        String    @id
  brief         Json
  // md5(FIT_VERSION + the exact brief JSON sent to the fit model, P6); learned lines are outside it.
  fitHash       String
  // Learned lines and their dismissals (P8), shown on /account.
  learned       Json      @default("[]")
  // One fit build per user at a time (P6): a lease set by compare-and-set.
  fitBuildUntil DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Phase P, P7 (modules/jobs/daily.ts): the day's set of jobs, released four at a time. One row per user per India day.
// Phase V, V1/V2: one account per (user, system, employer) the agent created or found on an employer's careers site.
// `secret`: AES-256-GCM of the password used there (a copy of User.applicationSecret at creation); null when passwordless.
model EmployerAccount {
  id         String    @id @default(cuid())
  userId     String
  system     String    // "workday" | "darwinbox" | "successfactors"
  employer   String    // Workday tenant, Darwinbox subdomain, SuccessFactors company id
  email      String
  secret     String?
  state      String    // creating | needs_verification | active | exists_elsewhere | failed
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  verifiedAt DateTime?
  lastUsedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, system, employer])
}

model DailySet {
  userId   String
  day      DateTime  @db.Date
  jobIds   String[]
  // How many of jobIds the deck may show; advanced by compare-and-set (PATCH /api/daily-set { from }).
  released Int       @default(4)
  // md5 of what built the set (tracks, nearby, avoid, verdict path and its hash): a change rebuilds it.
  basis    String
  // The day's one "Today's set is ready" push.
  pushedAt DateTime?
  builtAt  DateTime  @default(now())
  // What the agent did for the set, shown by the daily reveal (Phase R): { read, fields, fits, field: [{ company, logo }] }.
  stats      Json?
  // When the user saw the day's reveal: once a day, on any device.
  revealedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// A browser's Web Push subscription (lib/push.ts): one per browser the user turned notifications on in.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  isTest          Boolean @default(false)
  resumeKey       String
  resumeText      String
  fullName        String
  email           String
  phone           String?
  city            String?
  country         String?
  linkedin        String?
  github          String?
  portfolio       String?
  yearsExperience Float?
  currentTitle    String?
  currentCompany  String?
  skills          Json
  experience      Json
  // Tech tracks the candidate is matched on (modules/jobs/functions.ts), suggested from the resume, confirmed by the user.
  tracks          String[] @default([])
  // Confirm screen (Phase P, P4): adjacent tracks join the feed's; kinds and flags never shown (modules/jobs/gate.ts AVOIDS).
  showNearby      Boolean  @default(false)
  avoid           String[] @default([])
  // Meaning of the resume for matching (modules/jobs/semantic.ts), and the md5 of the text it was made from.
  embedding       Unsupported("halfvec(512)")?
  embeddedFrom    String?
  education       Json
  rawJson         Json
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evalPools      EvalPool[]
  feedLabels     FeedLabel[]
  evalJudgements EvalJudgement[]
  jobJudgements  JobJudgement[]
  fitJudgements  FitJudgement[]
}

model Answer {
  id        String   @id @default(cuid())
  userId    String
  key       String
  question  String
  answer    String
  source    String
  updatedAt DateTime @updatedAt
  // The job this answer was given for ({company, title, location, country}); null for answers given outside a form
  // (onboarding, the answers page). Questions that depend on the company, city or country are only reused when it matches.
  context   Json?
  // Answer memory (modules/answers/memory.ts, raw SQL): the question's embedding and the md5 of the wording it was
  // computed for, so a changed wording is re-embedded before the next recall.
  embedding    Unsupported("vector(1536)")?
  embeddedHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// One embedding per distinct question wording, shared by all users (wordings are not personal); filled by memory.ts.
model LabelEmbedding {
  labelHash String                       @id
  label     String
  embedding Unsupported("vector(1536)")
  model     String
  createdAt DateTime                     @default(now())
}

model Company {
  id             String    @id @default(cuid())
  source         String
  slug           String
  name           String
  active         Boolean   @default(true)
  stage          String?   // startup | midsize | mnc (prisma/companies.ts); the feed's Company type filter
  lastError      String?   // the last fetch failure, cleared by a fetch that works
  lastFetchedAt  DateTime?
  lastFetchCount Int?
  // Switched off automatically (modules/jobs/ingest.ts): 8 failed fetches in a row (a day), or no open jobs for 30 days.
  failedFetches  Int       @default(0)
  emptySince     DateTime?
  offReason      String?
  // "seed" (prisma/companies.ts) or "discovery" (modules/jobs/discovery.ts, added by its rule)
  addedBy        String    @default("seed")
  addedAt        DateTime  @default(now())
  // The logo on its public job board page (modules/jobs/logos.ts), shown on its cards; checked again after 30 days when missing.
  logoUrl        String?
  logoCheckedAt  DateTime?
  // Watched at its own pace (Phase M, M2; modules/jobs/cadence.ts): active (an India job now or in the last 30 days,
  // every 3 h) | open (other openings, daily) | empty (no openings, every 3 days) | dead (90 days empty or gone, monthly).
  tier           String    @default("active")
  nextFetchAt    DateTime  @default(now())
  indiaOpen      Int       @default(0) // India-eligible jobs it listed at the last fetch
  notFoundFetches Int      @default(0) // reads in a row that found no board (404, 410): 3 make it dead
  lastIndiaAt    DateTime? // the last fetch that listed an India-eligible job
  listHash       String? // the board's cheap list at the last fetch (Greenhouse, Workday): unchanged → nothing else read
  // Abroad jobs are stored only for the companies watched before Phase M (owner, 9 Nov); everyone else: India only.
  keepAbroad     Boolean   @default(false)
  // Phase W (docs/employers/TDD.md): the real employer this board account belongs to, and the evidence for it.
  employerId      String?   // null only between a new row's creation and the next linkPending()
  domain          String?   // this row's own website domain (TDD 4.4); null: none found
  domainBasis     String?   // board | redirect | job_links | name_evidence | owner (owner: never overwritten)
  domainCheckedAt DateTime? // the facts sweep's last look; null: never looked
  linkedAt        DateTime? // linkCompany's last run; linkPending picks rows whose domainCheckedAt is newer
  employer        Employer? @relation(fields: [employerId], references: [id], onDelete: SetNull)
  jobs           Job[]

  @@unique([source, slug])
  @@index([active, nextFetchAt])
  @@index([employerId])
}

// Phase W (docs/employers/TDD.md 4.3): one real business, identified by its website's registrable domain. Not
// EmployerAccount (Phase V: a user's own login on an employer's ATS).
model Employer {
  id          String    @id @default(cuid())
  slug        String    @unique // /companies/<slug>: [a-z0-9-], 2-60 characters; set once at creation, never changed
  name        String    // display name (TDD 4.4)
  nameBasis   String?   // owner: the owner set it, refreshEmployer leaves it alone
  domain      String?   @unique // registrable domain, "razorpay.com"; null: none found yet (a one-row employer)
  domainBasis String?   // board | redirect | job_links | name_evidence | owner
  logoUrl     String?
  stage       String?   // startup | midsize | mnc: the most common among its rows
  openJobs    Int       @default(0) // open public jobs (TDD 4.9), refreshEmployerCounts
  openIndia   Int       @default(0) // of those, eligibility india | remote_india
  nameKey     String    // sort key: lower-case ASCII of name; its first character is the letter ("0" for a digit)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  companies   Company[]
  aliases     EmployerAlias[]

  @@index([nameKey, openJobs])
  @@index([openIndia])
}

model EmployerAlias {
  slug       String   @id // an old slug (a merged employer's): answers 308 to the employer's slug
  employerId String
  createdAt  DateTime @default(now())
  employer   Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)

  @@index([employerId])
}

// Every company discovery has checked (modules/jobs/discovery.ts), so it never checks the same name twice and always
// moves on to new ones. status: added | few_india_jobs | not_on_board | error.
model DiscoveryCandidate {
  id           String   @id @default(cuid())
  source       String   @default("greenhouse")
  name         String
  slug         String?
  stage        String?
  from         String   // where the name came from: list | model
  status       String
  openJobs     Int      @default(0)
  indiaJobs    Int      @default(0)
  freshIndiaJobs Int    @default(0) // India-eligible jobs posted in the last 30 days
  checkedAt    DateTime @default(now())

  @@unique([source, name])
}

// The worker's heartbeat (src/worker/index.ts, every minute); /api/health reads it.
model WorkerBeat {
  id        String   @id // host name
  beatAt    DateTime
  startedAt DateTime
  // The worker can open a window a person sees (browser.ts canShowWindow): only such a worker connects signed-in sites.
  hasScreen Boolean  @default(false)
}

// A user's own account on a signed-in job site (Naukri, later LinkedIn; ARCHITECTURE 6.20, docs/naukri/TDD.md 4.3-4.5).
// The user signs in themselves in a visible window; we keep only the site's cookies, encrypted (browser.ts), under stateKey.
model SiteConnection {
  id           String    @id @default(cuid())
  userId       String
  site         String // naukri | linkedin
  status       String // connecting | connected | needs_signin | limited | failed | disconnected
  stateKey     String? // browser-state/<userId>/<site>.json (lib/storage.ts); null when there is no saved sign-in
  accountLabel String? // the first name the site shows for the account, for "Connected as ..."; nothing else is kept
  consentAt    DateTime // when the user accepted the account-risk notice
  connectedAt  DateTime?
  lastUsedAt   DateTime?
  lastIngestAt DateTime?
  pausedUntil  DateTime? // limited: nothing runs for this user and site until then
  lastError    String? // a sentence for the UI, never page text
  streamUrl    String? // K8: the worker's address for this user's streamed sign-in while its window is open; null otherwise
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, site])
}

// One per-user ingest run of a signed-in source (K2), as IngestRun is for the company boards.
model SourceRun {
  id         String    @id @default(cuid())
  userId     String
  site       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  searches   Int       @default(0)
  pages      Int       @default(0)
  listed     Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  details    Int       @default(0)
  stopReason String? // done | budget | needs_signin | challenge | refused | error
  error      String?

  @@index([userId, site, startedAt])
}

// The shared reader of a job site (K14, docs/naukri/TDD.md 13.17): the searches every connected user wants, deduped into
// buckets, each read once a window by our own signed-out window. One row per (site, bucket); nothing about a user.
model ReaderBucket {
  id           String    @id @default(cuid())
  site         String
  key          String // "java-developer|bengaluru|3" (modules/jobs/fetchers/naukriBuckets.ts bucketKey)
  kind         String    @default("search") // search (role, place, years: from connected users) | company (a company's own jobs, from a list)
  keyword      String
  location     String?
  experience   Int?
  users        Int       @default(0) // connected users whose searches it serves at the last plan
  everyHours   Int       @default(24)
  nextReadAt   DateTime  @default(now())
  lastReadAt   DateTime?
  claimedUntil DateTime? // a reader holds it until then (one window at a time)
  lastStop     String? // done | challenge | refused | error
  lastListed   Int?
  failures     Int       @default(0) // reads in a row that listed nothing because of an error
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@unique([site, key])
  @@index([site, active, nextReadAt])
}

// One reader window's run: counts only, never a title or a company. Its stop reason pauses the reader after a check.
model ReaderRun {
  id         String    @id @default(cuid())
  site       String
  reader     String // "reader-1": the window's own proxy session name (rotates after a refusal)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  buckets    Int       @default(0)
  pages      Int       @default(0)
  listed     Int       @default(0)
  created    Int       @default(0)
  updated    Int       @default(0)
  details    Int       @default(0)
  stopReason String? // done | budget | challenge | refused | error
  error      String?

  @@index([site, startedAt])
}

model Job {
  id            String   @id @default(cuid())
  source        String
  externalId    String
  companyId     String
  title         String
  location      String
  country       String
  remoteType    String
  experienceMin Int?
  description   String
  applyUrl      String
  postedAt      DateTime
  fetchedAt     DateTime
  closedAt      DateTime? // set when the company's board stops listing the job; cleared if it comes back
  // india | remote_india | abroad | unknown (modules/jobs/tagging.ts eligibility): the feed shows india and remote_india.
  eligibility   String   @default("unknown")
  // When ingest first saw the job ("new for you today").
  firstSeenAt   DateTime @default(now())
  // md5 of what ingest stores and tags from: an unchanged job is not written again.
  contentHash   String?
  // What kind of job (modules/jobs/functions.ts classifyTitle): engineering | data_ai | non_tech, a tech track, a level.
  function      String?
  track         String?
  seniority     String?
  // Meaning of the posting for resume matching (modules/jobs/semantic.ts, raw SQL): title + start of the description.
  embedding     Unsupported("halfvec(512)")?
  // The application form's questions read from the board's public API (modules/jobs/questions.ts), so the agent can
  // ask what it is missing before opening a browser. Null until fetched.
  questions          Json?
  // Which adapter applies when it is not the source's own: a Naukri listing that sends the user to Greenhouse, Lever,
  // Ashby or Keka (docs/naukri/TDD.md 4.6). Null: the source's own apply.
  applyVia           String?
  questionsFetchedAt DateTime?
  // The distinct words of the title and description, kept by a trigger (migration job_terms): the feed matches skills
  // in Postgres instead of downloading descriptions (modules/jobs/match.ts).
  // Left out of every Prisma read (omit in lib/db.ts) and never written by the app: the trigger owns it.
  terms              String[]
  // Phase M (docs/job-match/TDD.md §4.3): the vocabulary tech terms the posting names (modules/jobs/skills.ts, at
  // ingest), the subset the model labelled required (semantic.ts jobSkillLevels) and the contentHash it labelled.
  skills             String[] @default([])
  skillsRequired     String[] @default([])
  skillsHash         String?
  // Pay from the board's own structured fields only, never parsed from the description (modules/jobs/salary.ts).
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?
  salaryPeriod       String? // year | month | hour
  // Phase P (docs/relevance/TDD.md 4.1.2): the model's reading of the posting (modules/jobs/reading.ts): its field,
  // kind (full_time | contract | internship | ...), flags (commission_only, gig, ...) and the verified evidence and
  // requirement lines. readingCurrent is cleared by the job_reading_stale trigger when the title or description
  // really changes; the reader claims rows through readClaimedUntil and gives up for 24 h after 3 failed attempts.
  roleFamily         String?
  kind               String?
  flags              String[] @default([])
  reading            Json?
  readingCurrent     Boolean  @default(false)
  readAt             DateTime?
  readFailedAt       DateTime?
  readAttempts       Int      @default(0)
  readClaimedUntil   DateTime?
  raw           Json

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  evalPools      EvalPool[]
  feedLabels     FeedLabel[]
  evalJudgements EvalJudgement[]
  jobJudgements  JobJudgement[]
  fitJudgements  FitJudgement[]

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([country])
  @@index([source, country, postedAt]) // the feed's filter
  @@index([source, eligibility, postedAt])
  @@index([track])
  @@index([terms], type: Gin) // feedRows looks skills up here (migration job_terms_index)
  @@index([companyId, closedAt]) // a company page and the employer counts read jobs by company
}

model Swipe {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  direction String
  // Why a left swipe was made (P8): not_my_field, too_senior, place, company or other; null when not said.
  reason    String?
  // The job's family (trackOf) when the swipe was made, so a later re-reading never moves an old skip (P8).
  family    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Application {
  id                String    @id @default(cuid())
  userId            String
  jobId             String
  status            String
  attempt           Int       @default(0)
  fields            Json
  pendingQuestions  Json
  screenshotKey     String?
  error             String?
  submittedAt       DateTime?
  verificationCode  String?   // one-time ATS email code typed by the user; cleared as soon as the worker reads it
  heartbeatAt       DateTime? // refreshed by the worker while it runs this application; a stale one means the worker died
  codeRequestId     String?   // id of the in-flight email-code agent request; callbacks must match it
  codeRequestStatus String?   // pending | found | not_found | ambiguous | no_access | failed
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ApplicationEvent[]

  @@index([userId, status])
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  type          String
  message       String
  rule          String?
  data          Json?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, type, createdAt]) // governance counters and the latest prompt per application
}

model FileBlob {
  key         String   @id
  bytes       Bytes
  contentType String
  size        Int
  userId      String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model MockSubmission {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now())
}

model FieldMappingCache {
  id        String   @id @default(cuid())
  source    String
  labelHash String
  key       String
  createdAt DateTime @default(now())

  @@unique([source, labelHash])
}

// One row per user while their application is submitting or waiting for a security code, so two workers
// (or two processes) never have two of that user's forms waiting on emailed codes at once.
// The lease expires on its own if the holder dies.
model SubmitLock {
  userId    String   @id
  holderId  String
  expiresAt DateTime
}

// One row per counted action, so a rate limit is "how many rows in the last N seconds for this key".
model RateEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// "Fill your gaps" (T56): the result of pre-scanning a user's top feed jobs (worker job `prescan`). FeedScan is the
// summary (how many jobs could be answered in full); FeedGap one missing fact and how many scanned jobs it would unblock.
model FeedScan {
  userId    String   @id
  scanned   Int
  covered   Int
  updatedAt DateTime @updatedAt
}

model FeedGap {
  userId    String
  key       String
  label     String
  type      String
  options   Json?
  // For a question about the job's country (work authorization, sponsorship), the country it was grouped by; the
  // answer is saved with it so memory can reuse it for every job in that country.
  context   Json?
  jobs      Int
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

// One ingest run (modules/jobs/ingest.ts): an unfinished run stops another from overlapping it; the counts are the
// daily freshness numbers.
model IngestRun {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  companies       Int       @default(0)
  failed          Int       @default(0)
  fetched         Int       @default(0)
  created         Int       @default(0)
  updated         Int       @default(0)
  closed          Int       @default(0)
  deleted         Int       @default(0)
  createdEligible Int       @default(0)

  @@index([startedAt])
}

// One row per board per UTC day (Phase M, M1; modules/jobs/boardDay.ts): the yardstick that orders the boards.
// Written at 23:30 UTC by the worker; a re-run of the same day overwrites it.
model BoardDay {
  day            DateTime @db.Date
  source         String
  companies      Int // active companies on the board
  // Watch tiers (M2). Until M2 lands every active company counts as active.
  active         Int
  open           Int
  empty          Int
  dead           Int
  openIndia      Int // open India-eligible jobs (india, remote_india) when the row was written
  openIndiaTech  Int // of which function engineering or data_ai
  openIndiaEntry Int // of which intern or entry level, or asking 2 years or less
  newIndia       Int // India-eligible jobs first seen that day: the flow that feeds swipes
  swipesRight    Int
  submitted      Int
  writtenAt      DateTime @default(now()) @updatedAt

  @@id([day, source])
}

// The model's verdict on one job for one resume (modules/jobs/semantic.ts judgeJobs): strong | good | stretch | no, and
// why. Valid while the resume text (fromHash) and the posting (jobHash = Job.contentHash) are unchanged.
model JobJudgement {
  profileId String
  jobId     String
  fromHash  String
  jobHash   String
  fit       String
  // How close the work is to the candidate's: same | close | related | different (related = another field, shown only on request).
  field     String?
  why       String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([profileId, jobId])
  @@index([jobId])
}

// Phase P, P6 (docs/relevance/TDD.md 4.1 item 7): the fit verdict (modules/jobs/fit.ts, behind RELEVANCE_FIT) on one job
// for one candidate brief: strong | good | stretch | no, why (at most 12 words) and the requirement line it rests on
// (an index into Job.reading.requirements). Valid while the brief (fitHash) and the exact per-job JSON sent (jobHash)
// are unchanged. Its own table: the old path keeps JobJudgement, so flipping the switch re-judges nothing.
model FitJudgement {
  profileId     String
  jobId         String
  fitHash       String
  jobHash       String
  fit           String
  why           String
  evidenceIndex Int?
  createdAt     DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([profileId, jobId])
  @@index([jobId])
}

// Phase P, P2 (docs/relevance/TDD.md 7.1): the evaluation's stored pools, the owner's relevance labels and the verdicts
// the eval asked for. Written only by scripts/label-candidates.ts and scripts/relevance-eval.ts; never read by the feed.
// deleteOldClosedJobs keeps pooled and labelled jobs; an account deletion removes its rows (cascade).
model EvalPool {
  profileId String
  round     Int
  jobId     String
  // Which candidate lists picked the job for labelling ("old,reading", "random"), or "pool" when none did.
  source    String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([profileId, round, jobId])
  @@index([jobId])
}

model FeedLabel {
  profileId String
  jobId     String
  // Relevant to this profile; null = the labeller could not tell.
  relevant  Boolean?
  by        String
  at        DateTime @default(now())
  round     Int

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([profileId, jobId])
  @@index([jobId])
}

model EvalJudgement {
  profileId String
  jobId     String
  // old (semantic.ts judgeBatch) | fit (fit.ts dry run, P6)
  path      String
  fromHash  String
  jobHash   String
  fit       String
  why       String
  evidence  Int?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([profileId, jobId, path])
  @@index([jobId])
}

// Share links (Phase U7, docs/share/TDD.md 4.2): one row per step a visitor reached for a shared job, at most once per
// visitor, job and step. No personal data: the visitor id is random (the sa_vid cookie); the user id is set once
// signed in and cleared if the account is deleted.
model FunnelEvent {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  // view | apply_tap | signed_in | resume_read | profile_saved | queued | blocked | landed | submitted
  step      String
  visitorId String
  userId    String?
  jobId     String
  // li | x | wa | copy, from ?s= on the link; on the view step
  source    String?
  // the block rule, the application id (queued, landed, submitted), or "in_app_browser"
  detail    String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([visitorId, jobId, step])
  @@index([at, step])
  @@index([detail])
}

// Phase Y, Y2 (docs/whatsapp/TDD.md 4.3, modules/whatsapp): SwipeApply on WhatsApp through Meta's Cloud API. The link is the
// user's opt-in. `phone` is the only copy of the number anywhere: never logged, never in an event, shown masked.
model WhatsAppLink {
  userId         String    @id
  // E.164 with the plus, e.g. +919876543210
  phone          String    @unique
  linkedAt       DateTime  @default(now())
  // STOP (Y5): nothing is sent until the user writes again
  optedOutAt     DateTime?
  // "pause for 3 days" (Y5)
  pausedUntil    DateTime?
  timezone       String    @default("Asia/Kolkata")
  // HH:mm in the user's zone
  morningAt      String    @default("08:30")
  // 0-3, bounded by the whatsapp_drops_per_day rule (Y5)
  dropsPerDay    Int       @default(2)
  // The service window: open while now - lastInboundAt is under 24 hours
  lastInboundAt  DateTime?
  lastOutboundAt DateTime?
  // today's times (Y3, Y5), Zod-validated in modules/whatsapp/state.ts
  plan           Json?
  // the conversation state (Y3, Y4), Zod-validated in modules/whatsapp/state.ts
  state          Json?
  // drops in a row with no reply; the back-off reads it (Y5)
  ignored        Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per message in or out; no body is ever stored. The unique wamid makes a second delivery of one inbound a no-op.
model WhatsAppMessage {
  id            String   @id @default(cuid())
  wamid         String   @unique
  // null for a message from an unlinked number (pruned after 24 hours)
  userId        String?
  // in | out
  direction     String
  // text | button | list | flow | document | other | template:<name> | status
  kind          String
  applicationId String?
  // sent | delivered | read | failed (outbound, from the status webhooks)
  status        String?
  // Meta's error code only, never a message text
  error         String?
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// "Join <code>": 8 characters, 15 minutes, one use, bound to the user who asked for it.
model WhatsAppLinkCode {
  code      String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}
