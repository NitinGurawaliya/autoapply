generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  autoReadOtp   Boolean   @default(false) // user consented to the email-code agent reading their mailbox
  createdAt     DateTime  @default(now())
  // The newest job a "new matches" push has covered (lib/push.ts, modules/jobs/warm.ts): later ones are new.
  matchesAlertedAt DateTime?

  profile      Profile?
  answers      Answer[]
  swipes       Swipe[]
  applications Application[]
  accounts     Account[]
  sessions     Session[]
  pushSubscriptions PushSubscription[]
  brief        CandidateBrief?
  dailySets    DailySet[]
}

// Phase P, P5 (modules/profile/brief.ts): what the agent knows about the candidate for judging fit: tracks, nearby,
// years, title, top skills; never contact data. Its own table, so a rebuild leaves Profile.updatedAt alone.
model CandidateBrief {
  userId        String    @id
  brief         Json
  // md5(FIT_VERSION + the exact brief JSON sent to the fit model, P6); learned lines are outside it.
  fitHash       String
  // Learned lines and their dismissals (P8), shown on /account.
  learned       Json      @default("[]")
  // One fit build per user at a time (P6): a lease set by compare-and-set.
  fitBuildUntil DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Phase P, P7 (modules/jobs/daily.ts): the day's set of jobs, released four at a time. One row per user per India day.
model DailySet {
  userId   String
  day      DateTime  @db.Date
  jobIds   String[]
  // How many of jobIds the deck may show; advanced by compare-and-set (PATCH /api/daily-set { from }).
  released Int       @default(4)
  // md5 of what built the set (tracks, nearby, avoid, verdict path and its hash): a change rebuilds it.
  basis    String
  // The day's one "Today's set is ready" push.
  pushedAt DateTime?
  builtAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

// A browser's Web Push subscription (lib/push.ts): one per browser the user turned notifications on in.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id              String  @id @default(cuid())
  userId          String  @unique
  isTest          Boolean @default(false)
  resumeKey       String
  resumeText      String
  fullName        String
  email           String
  phone           String?
  city            String?
  country         String?
  linkedin        String?
  github          String?
  portfolio       String?
  yearsExperience Float?
  currentTitle    String?
  currentCompany  String?
  skills          Json
  experience      Json
  // Tech tracks the candidate is matched on (modules/jobs/functions.ts), suggested from the resume, confirmed by the user.
  tracks          String[] @default([])
  // Confirm screen (Phase P, P4): adjacent tracks join the feed's; kinds and flags never shown (modules/jobs/gate.ts AVOIDS).
  showNearby      Boolean  @default(false)
  avoid           String[] @default([])
  // Meaning of the resume for matching (modules/jobs/semantic.ts), and the md5 of the text it was made from.
  embedding       Unsupported("halfvec(512)")?
  embeddedFrom    String?
  education       Json
  rawJson         Json
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  evalPools      EvalPool[]
  feedLabels     FeedLabel[]
  evalJudgements EvalJudgement[]
}

model Answer {
  id        String   @id @default(cuid())
  userId    String
  key       String
  question  String
  answer    String
  source    String
  updatedAt DateTime @updatedAt
  // The job this answer was given for ({company, title, location, country}); null for answers given outside a form
  // (onboarding, the answers page). Questions that depend on the company, city or country are only reused when it matches.
  context   Json?
  // Answer memory (modules/answers/memory.ts, raw SQL): the question's embedding and the md5 of the wording it was
  // computed for, so a changed wording is re-embedded before the next recall.
  embedding    Unsupported("vector(1536)")?
  embeddedHash String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

// One embedding per distinct question wording, shared by all users (wordings are not personal); filled by memory.ts.
model LabelEmbedding {
  labelHash String                       @id
  label     String
  embedding Unsupported("vector(1536)")
  model     String
  createdAt DateTime                     @default(now())
}

model Company {
  id             String    @id @default(cuid())
  source         String
  slug           String
  name           String
  active         Boolean   @default(true)
  stage          String?   // startup | midsize | mnc (prisma/companies.ts); the feed's Company type filter
  lastError      String?   // the last fetch failure, cleared by a fetch that works
  lastFetchedAt  DateTime?
  lastFetchCount Int?
  // Switched off automatically (modules/jobs/ingest.ts): 8 failed fetches in a row (a day), or no open jobs for 30 days.
  failedFetches  Int       @default(0)
  emptySince     DateTime?
  offReason      String?
  // "seed" (prisma/companies.ts) or "discovery" (modules/jobs/discovery.ts, added by its rule)
  addedBy        String    @default("seed")
  addedAt        DateTime  @default(now())
  // The logo on its public job board page (modules/jobs/logos.ts), shown on its cards; checked again after 30 days when missing.
  logoUrl        String?
  logoCheckedAt  DateTime?
  // Watched at its own pace (Phase M, M2; modules/jobs/cadence.ts): active (an India job now or in the last 30 days,
  // every 3 h) | open (other openings, daily) | empty (no openings, every 3 days) | dead (90 days empty or gone, monthly).
  tier           String    @default("active")
  nextFetchAt    DateTime  @default(now())
  indiaOpen      Int       @default(0) // India-eligible jobs it listed at the last fetch
  notFoundFetches Int      @default(0) // reads in a row that found no board (404, 410): 3 make it dead
  lastIndiaAt    DateTime? // the last fetch that listed an India-eligible job
  listHash       String? // the board's cheap list at the last fetch (Greenhouse, Workday): unchanged → nothing else read
  // Abroad jobs are stored only for the companies watched before Phase M (owner, 9 Nov); everyone else: India only.
  keepAbroad     Boolean   @default(false)
  jobs           Job[]

  @@unique([source, slug])
  @@index([active, nextFetchAt])
}

// Every company discovery has checked (modules/jobs/discovery.ts), so it never checks the same name twice and always
// moves on to new ones. status: added | few_india_jobs | not_on_board | error.
model DiscoveryCandidate {
  id           String   @id @default(cuid())
  source       String   @default("greenhouse")
  name         String
  slug         String?
  stage        String?
  from         String   // where the name came from: list | model
  status       String
  openJobs     Int      @default(0)
  indiaJobs    Int      @default(0)
  freshIndiaJobs Int    @default(0) // India-eligible jobs posted in the last 30 days
  checkedAt    DateTime @default(now())

  @@unique([source, name])
}

// The worker's heartbeat (src/worker/index.ts, every minute); /api/health reads it.
model WorkerBeat {
  id        String   @id // host name
  beatAt    DateTime
  startedAt DateTime
}

model Job {
  id            String   @id @default(cuid())
  source        String
  externalId    String
  companyId     String
  title         String
  location      String
  country       String
  remoteType    String
  experienceMin Int?
  description   String
  applyUrl      String
  postedAt      DateTime
  fetchedAt     DateTime
  closedAt      DateTime? // set when the company's board stops listing the job; cleared if it comes back
  // india | remote_india | abroad | unknown (modules/jobs/tagging.ts eligibility): the feed shows india and remote_india.
  eligibility   String   @default("unknown")
  // When ingest first saw the job ("new for you today").
  firstSeenAt   DateTime @default(now())
  // md5 of what ingest stores and tags from: an unchanged job is not written again.
  contentHash   String?
  // What kind of job (modules/jobs/functions.ts classifyTitle): engineering | data_ai | non_tech, a tech track, a level.
  function      String?
  track         String?
  seniority     String?
  // Meaning of the posting for resume matching (modules/jobs/semantic.ts, raw SQL): title + start of the description.
  embedding     Unsupported("halfvec(512)")?
  // The application form's questions read from the board's public API (modules/jobs/questions.ts), so the agent can
  // ask what it is missing before opening a browser. Null until fetched.
  questions          Json?
  questionsFetchedAt DateTime?
  // The distinct words of the title and description, kept by a trigger (migration job_terms): the feed matches skills
  // in Postgres instead of downloading descriptions (modules/jobs/match.ts).
  // Left out of every Prisma read (omit in lib/db.ts) and never written by the app: the trigger owns it.
  terms              String[]
  // Phase M (docs/job-match/TDD.md §4.3): the vocabulary tech terms the posting names (modules/jobs/skills.ts, at
  // ingest), the subset the model labelled required (semantic.ts jobSkillLevels) and the contentHash it labelled.
  skills             String[] @default([])
  skillsRequired     String[] @default([])
  skillsHash         String?
  // Pay from the board's own structured fields only, never parsed from the description (modules/jobs/salary.ts).
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?
  salaryPeriod       String? // year | month | hour
  // Phase P (docs/relevance/TDD.md 4.1.2): the model's reading of the posting (modules/jobs/reading.ts): its field,
  // kind (full_time | contract | internship | ...), flags (commission_only, gig, ...) and the verified evidence and
  // requirement lines. readingCurrent is cleared by the job_reading_stale trigger when the title or description
  // really changes; the reader claims rows through readClaimedUntil and gives up for 24 h after 3 failed attempts.
  roleFamily         String?
  kind               String?
  flags              String[] @default([])
  reading            Json?
  readingCurrent     Boolean  @default(false)
  readAt             DateTime?
  readFailedAt       DateTime?
  readAttempts       Int      @default(0)
  readClaimedUntil   DateTime?
  raw           Json

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  evalPools      EvalPool[]
  feedLabels     FeedLabel[]
  evalJudgements EvalJudgement[]

  @@unique([source, externalId])
  @@index([postedAt])
  @@index([country])
  @@index([source, country, postedAt]) // the feed's filter
  @@index([source, eligibility, postedAt])
  @@index([track])
  @@index([terms], type: Gin) // feedRows looks skills up here (migration job_terms_index)
}

model Swipe {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  direction String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Application {
  id                String    @id @default(cuid())
  userId            String
  jobId             String
  status            String
  attempt           Int       @default(0)
  fields            Json
  pendingQuestions  Json
  screenshotKey     String?
  error             String?
  submittedAt       DateTime?
  verificationCode  String?   // one-time ATS email code typed by the user; cleared as soon as the worker reads it
  heartbeatAt       DateTime? // refreshed by the worker while it runs this application; a stale one means the worker died
  codeRequestId     String?   // id of the in-flight email-code agent request; callbacks must match it
  codeRequestStatus String?   // pending | found | not_found | ambiguous | no_access | failed
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events ApplicationEvent[]

  @@index([userId, status])
}

model ApplicationEvent {
  id            String   @id @default(cuid())
  applicationId String
  type          String
  message       String
  rule          String?
  data          Json?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicationId, type, createdAt]) // governance counters and the latest prompt per application
}

model FileBlob {
  key         String   @id
  bytes       Bytes
  contentType String
  size        Int
  userId      String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

model MockSubmission {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now())
}

model FieldMappingCache {
  id        String   @id @default(cuid())
  source    String
  labelHash String
  key       String
  createdAt DateTime @default(now())

  @@unique([source, labelHash])
}

// One row per user while their application is submitting or waiting for a security code, so two workers
// (or two processes) never have two of that user's forms waiting on emailed codes at once.
// The lease expires on its own if the holder dies.
model SubmitLock {
  userId    String   @id
  holderId  String
  expiresAt DateTime
}

// One row per counted action, so a rate limit is "how many rows in the last N seconds for this key".
model RateEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// "Fill your gaps" (T56): the result of pre-scanning a user's top feed jobs (worker job `prescan`). FeedScan is the
// summary (how many jobs could be answered in full); FeedGap one missing fact and how many scanned jobs it would unblock.
model FeedScan {
  userId    String   @id
  scanned   Int
  covered   Int
  updatedAt DateTime @updatedAt
}

model FeedGap {
  userId    String
  key       String
  label     String
  type      String
  options   Json?
  // For a question about the job's country (work authorization, sponsorship), the country it was grouped by; the
  // answer is saved with it so memory can reuse it for every job in that country.
  context   Json?
  jobs      Int
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

// One ingest run (modules/jobs/ingest.ts): an unfinished run stops another from overlapping it; the counts are the
// daily freshness numbers.
model IngestRun {
  id              String    @id @default(cuid())
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  companies       Int       @default(0)
  failed          Int       @default(0)
  fetched         Int       @default(0)
  created         Int       @default(0)
  updated         Int       @default(0)
  closed          Int       @default(0)
  deleted         Int       @default(0)
  createdEligible Int       @default(0)

  @@index([startedAt])
}

// One row per board per UTC day (Phase M, M1; modules/jobs/boardDay.ts): the yardstick that orders the boards.
// Written at 23:30 UTC by the worker; a re-run of the same day overwrites it.
model BoardDay {
  day            DateTime @db.Date
  source         String
  companies      Int // active companies on the board
  // Watch tiers (M2). Until M2 lands every active company counts as active.
  active         Int
  open           Int
  empty          Int
  dead           Int
  openIndia      Int // open India-eligible jobs (india, remote_india) when the row was written
  openIndiaTech  Int // of which function engineering or data_ai
  openIndiaEntry Int // of which intern or entry level, or asking 2 years or less
  newIndia       Int // India-eligible jobs first seen that day: the flow that feeds swipes
  swipesRight    Int
  submitted      Int
  writtenAt      DateTime @default(now()) @updatedAt

  @@id([day, source])
}

// The model's verdict on one job for one resume (modules/jobs/semantic.ts judgeJobs): strong | good | stretch | no, and
// why. Valid while the resume text (fromHash) and the posting (jobHash = Job.contentHash) are unchanged.
model JobJudgement {
  profileId String
  jobId     String
  fromHash  String
  jobHash   String
  fit       String
  // How close the work is to the candidate's: same | close | related | different (related = another field, shown only on request).
  field     String?
  why       String
  createdAt DateTime @default(now())

  @@id([profileId, jobId])
}

// Phase P, P2 (docs/relevance/TDD.md 7.1): the evaluation's stored pools, the owner's relevance labels and the verdicts
// the eval asked for. Written only by scripts/label-candidates.ts and scripts/relevance-eval.ts; never read by the feed.
// deleteOldClosedJobs keeps pooled and labelled jobs; an account deletion removes its rows (cascade).
model EvalPool {
  profileId String
  round     Int
  jobId     String
  // Which candidate lists picked the job for labelling ("old,reading", "random"), or "pool" when none did.
  source    String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([profileId, round, jobId])
  @@index([jobId])
}

model FeedLabel {
  profileId String
  jobId     String
  // Relevant to this profile; null = the labeller could not tell.
  relevant  Boolean?
  by        String
  at        DateTime @default(now())
  round     Int

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([profileId, jobId])
  @@index([jobId])
}

model EvalJudgement {
  profileId String
  jobId     String
  // old (semantic.ts judgeBatch) | fit (fit.ts dry run, P6)
  path      String
  fromHash  String
  jobHash   String
  fit       String
  why       String
  evidence  Int?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([profileId, jobId, path])
  @@index([jobId])
}
