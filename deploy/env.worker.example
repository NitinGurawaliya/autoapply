# Copy to deploy/.env.worker on the home server (gitignored) and fill in the same values as today's .env.worker.
# WORKER_NAME and APPLY_CONCURRENCY are set per worker in docker-compose.yml.
# Pooled Neon connection (the app's database).
DATABASE_URL=
# Direct Neon connection (pg-boss queue and migrations).
DIRECT_URL=
# Files (resumes, screenshots) live in Postgres.
STORAGE_DRIVER=postgres
OPENAI_API_KEY=
# The live web app, for links in notifications.
APP_URL=https://autoapply-u74v.vercel.app
