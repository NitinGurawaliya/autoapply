# Pulls the newest SwipeApply worker image and restarts the workers if it changed (deploy/update.sh).
# Install: docs/DEPLOY.md, "Home server". Adjust User and the paths if your checkout is not in /home/swipeapply/swipeapply.
[Unit]
Description=Update the SwipeApply workers from Docker Hub
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=swipeapply
ExecStart=/home/swipeapply/swipeapply/deploy/update.sh
