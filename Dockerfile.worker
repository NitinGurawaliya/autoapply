# The SwipeApply worker (docs/DEPLOY.md): pg-boss jobs for apply, ingest, discovery and pre-scan, Playwright with
# Chromium. The official Playwright image matches the playwright version in package.json, so its browsers fit.
FROM mcr.microsoft.com/playwright:v1.63.0-noble

WORKDIR /app
ENV NODE_ENV=production \
    BROWSER_PROFILE_ROOT=/data/browser-profiles \
    WORKER_SINGLE_LOCK=off

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --include=dev
# Google Chrome for the visible window (modules/apply/browser.ts prefers it for handoffs), the browser the worker's own
# Submit went through in on Windows at Ashby's "low" (27 Oct). Used only when the container is given a screen
# (docs/DEPLOY.md, "Docker worker with a screen"); headless runs keep the bundled Chromium.
RUN npx playwright install --with-deps chrome

COPY . .

# Browser profiles (per-user cookies) on a volume when the host offers one; the worker works without it too.
RUN mkdir -p /data/browser-profiles
# One Node process with tsx as a loader (not npm, not the tsx wrapper, which run the worker as a child and pass the
# stop signal on a second time): the worker gets SIGTERM once and finishes the runs in progress (worker/index.ts).
# Run with `init: true` or `docker run --init`. Same code as `npm run worker:prod`.
CMD ["node", "--import", "tsx", "src/worker/index.ts"]
