# SwipeApply settings (docs/DEPLOY.md, ARCHITECTURE §11). Copy to .env for local work; on a host, set them in its
# dashboard. Never commit real values.

# Postgres (Neon): pooled for the web app, direct for migrations and the job queue (pg-boss).
DATABASE_URL=
DIRECT_URL=

# Sign-in (Auth.js + Google). AUTH_SECRET: openssl rand -base64 32. Google redirect URI: <APP_URL>/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public address of the web app (links in notifications, sign-in).
APP_URL=http://localhost:3000

# Files (resumes, screenshots) live in Postgres.
STORAGE_DRIVER=postgres

# Model for resume reading, answering, matching and discovery; embeddings use the same key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Browser push (new matching jobs, runs waiting on the user). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Worker
APPLY_CONCURRENCY=3                # browsers at once (about 0.5 GB of RAM each)
INGEST_CRON=0 */3 * * *            # fetch every company's open jobs (UTC)
INGEST_DAYS=60
DISCOVER_CRON=30 1 * * *           # find new companies once a day (UTC)
BROWSER_PROFILE_ROOT=              # default ./.browser-profiles
WORKER_NAME=                       # shown by /api/health; default: the host name
DEMO_HEADED=                       # 1 = show the browser (local demos only)

# Optional
ADMIN_EMAILS=                      # who may start an ingest by hand (comma separated)
NOTIFY_WEBHOOK_URL=                # an email service webhook for "needs you"
NOTIFY_WEBHOOK_SECRET=
ENABLE_MOCK_FORM=                  # 1 = keep /mock/greenhouse in production (test profiles)
BROWSER_STATE_KEY=                 # base64 of 32 random bytes; encrypts saved sign-ins to users' own job-site accounts (Naukri). Needed on the worker with a screen
SIGNED_IN_PROXY_URL=               # the residential proxy provider's gateway with {session} in it (K7), e.g. http://cust-{session}:pass@gate.example.com:7000; "off" = direct, development only; unset = signed-in sites refused
SIGNED_IN_PROXY_SECRET=            # names each user's sticky proxy session (HMAC of the user id); falls back to BROWSER_STATE_KEY
SOURCE_STREAM_SECRET=              # K8: 32+ random characters, the same on web and worker; signs the phone's pass to its streamed sign-in. Unset: no stream
SOURCE_STREAM_PORT=                # K8, worker: the port the streamed-sign-in relay listens on (e.g. 8787)
SOURCE_STREAM_PUBLIC_URL=          # K8, worker: the https address phones reach that port at (the host's domain or a tunnel); http only for localhost
ENABLE_NAUKRI=                     # 1 = Naukri jobs in the feed for users who connected their account
ENABLE_NAUKRI_APPLY=               # 1 (with ENABLE_NAUKRI=1) = a right swipe on a Naukri job applies there; on after the first real submit
HIRIST_READER=                    # 1 (K17): the same for Hirist's jobs; ENABLE_HIRIST=1 shows them to users who connected Hirist (K18)
NAUKRI_READER=                    # 1 (K14): our own signed-out reader finds Naukri's jobs for everyone; set on the worker with a screen and on the web app
SOURCE_INGEST_CRON=                # default 0 */8 * * * (UTC): each connected account's Naukri run

# Share links /j/... (docs/share/TDD.md): on in development; set 1 in production after the phone check.
SHARE_LINKS=
