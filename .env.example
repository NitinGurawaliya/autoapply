# SwipeApply settings (docs/DEPLOY.md, ARCHITECTURE §11). Copy to .env for local work; on a host, set them in its
# dashboard. Never commit real values.

# Postgres (Neon): pooled for the web app, direct for migrations and the job queue (pg-boss).
DATABASE_URL=
DIRECT_URL=

# Sign-in (Auth.js + Google). AUTH_SECRET: openssl rand -base64 32. Google redirect URI: <APP_URL>/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Public address of the web app (links in notifications, sign-in).
APP_URL=http://localhost:3000

# Files (resumes, screenshots) live in Postgres.
STORAGE_DRIVER=postgres

# Model for resume reading, answering, matching and discovery; embeddings use the same key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Browser push (new matching jobs, runs waiting on the user). Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Worker
APPLY_CONCURRENCY=3                # browsers at once (about 0.5 GB of RAM each)
INGEST_CRON=0 */3 * * *            # fetch every company's open jobs (UTC)
INGEST_DAYS=60
DISCOVER_CRON=30 1 * * *           # find new companies once a day (UTC)
BROWSER_PROFILE_ROOT=              # default ./.browser-profiles
WORKER_NAME=                       # shown by /api/health; default: the host name
DEMO_HEADED=                       # 1 = show the browser (local demos only)

# Optional
ADMIN_EMAILS=                      # who may start an ingest by hand (comma separated)
NOTIFY_WEBHOOK_URL=                # an email service webhook for "needs you"
NOTIFY_WEBHOOK_SECRET=
ENABLE_MOCK_FORM=                  # 1 = keep /mock/greenhouse in production (test profiles)
